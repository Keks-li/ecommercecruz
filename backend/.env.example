# ──────────────────────────────────────────────
# Supabase / PostgreSQL
# ──────────────────────────────────────────────
# Project region: eu-west-2 (London)
# Get from: Supabase → Project Settings → Database → Connection string → URI
#
# Transaction pooler URL (port 6543) — use for production / serverless
DATABASE_URL=postgresql://postgres.nmknkskyzmlocnjbrtub:[DB_PASSWORD]@aws-0-eu-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1

# ──────────────────────────────────────────────
# Server
# ──────────────────────────────────────────────
PORT=5000
NODE_ENV=production
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# ──────────────────────────────────────────────
# Cloudinary
# ──────────────────────────────────────────────
CLOUDINARY_URL=cloudinary://your-api-key:your-api-secret@your-cloud-name

# ──────────────────────────────────────────────
# CORS — comma-separated list of allowed front-end origins
# ──────────────────────────────────────────────
ALLOWED_ORIGINS=https://cruzaro.pages.dev,https://www.cruzaro.com
