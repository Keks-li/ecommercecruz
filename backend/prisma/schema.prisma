// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CUSTOMER
}

enum Status {
  ACTIVE
  SUSPENDED
}

enum ProductType {
  SINGLE
  COMBO
}

enum PaymentStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  OVERDUE
}

enum CancellationStatus {
  NONE
  REQUESTED
  APPROVED
  REJECTED
  REFUNDED
}

model User {
  id         Int      @id @default(autoincrement())
  email      String   @unique
  password   String
  role       Role
  status     Status
  created_at DateTime @default(now())
  orders     Order[]
}

model Product {
  id              Int          @id @default(autoincrement())
  name            String
  description     String
  price           Float
  unique_code     String       @unique
  status          Status
  type            ProductType  @default(SINGLE)
  category        String?
  image_url       String
  stock           Int          @default(10)
  created_at      DateTime     @default(now())
  order_items     OrderItem[]
  payment_rule_id Int?
  payment_rule    PaymentRule? @relation(fields: [payment_rule_id], references: [id], onDelete: SetNull)
}

model Order {
  id                 Int                  @id @default(autoincrement())
  user_id            Int
  user               User                 @relation(fields: [user_id], references: [id])
  total_price        Float
  amount_paid        Float                @default(0)
  penalty_amount     Float                @default(0)
  penalty_pct        Float?
  penalty_applied    Boolean              @default(false)
  payment_status     PaymentStatus        @default(PENDING)
  payment_due_date   DateTime?
  cancellation_status CancellationStatus  @default(NONE)
  status             String
  pickup_region      String?
  pickup_district    String?
  pickup_city        String?
  created_at         DateTime             @default(now())
  items              OrderItem[]
  transactions       PaymentTransaction[]
  cancellation       CancellationRequest?
}

model OrderItem {
  id         Int      @id @default(autoincrement())
  order_id   Int
  order      Order    @relation(fields: [order_id], references: [id])
  product_id Int
  product    Product  @relation(fields: [product_id], references: [id])
  quantity   Int
  price      Float
  created_at DateTime @default(now())
}

// Every payment event against an order
model PaymentTransaction {
  id             Int      @id @default(autoincrement())
  order_id       Int
  order          Order    @relation(fields: [order_id], references: [id])
  amount         Float
  payment_method String   @default("MANUAL")
  reference      String?
  note           String?
  created_at     DateTime @default(now())
}

// Cancellation / refund requests
model CancellationRequest {
  id                  Int                @id @default(autoincrement())
  order_id            Int                @unique
  order               Order              @relation(fields: [order_id], references: [id])
  requested_by        Int
  reason              String
  cancellation_fee_pct Float
  refund_amount       Float
  status              CancellationStatus @default(REQUESTED)
  admin_note          String?
  created_at          DateTime           @default(now())
  updated_at          DateTime           @updatedAt
}

// Generalised Payment Rules that can be applied to products
model PaymentRule {
  id                     Int       @id @default(autoincrement())
  name                   String    @unique
  is_default             Boolean   @default(false)
  default_deadline_days  Int       @default(14)
  default_penalty_pct    Float     @default(10)
  grace_period_days      Int       @default(3)
  default_cancel_fee_pct Float     @default(15)
  enable_recurring       Boolean   @default(false)
  penalty_frequency      String    @default("monthly")
  max_refund_days        Int       @default(30)
  updated_at             DateTime  @updatedAt
  products               Product[]
}

// Immutable audit trail
model AuditLog {
  id         Int      @id @default(autoincrement())
  user_id    Int?
  action     String
  entity     String
  entity_id  Int?
  old_value  String?
  new_value  String?
  ip_address String?
  created_at DateTime @default(now())
}
